N, K = map(int, input().split())
actions = [list(input().split()) for _ in range(N)]
# N만한 queue배열 만들기
queue = [0] * N
start = 0
pointer = 0
end = K-1

for action in actions:
	if action[0] == 'push':
		if pointer > end:
			print('Overflow')
		else:
			queue[pointer] = action[1]
			pointer += 1
	else:
		if pointer <= start:
			print('Underflow')
		else:
			print(queue[start])
			start += 1
			end += 1